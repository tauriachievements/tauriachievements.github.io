# MythicPlusExporter writes LF; keep it LF on checkout so autocrlf does not warn on every add/commit.
spa/src/mythic-plus-data/** text eol=lf
# RaidLogExporter writes LF as well.
spa/src/raid-log-data/** text eol=lf
# ArenaLadderExporter writes LF as well.
spa/src/arena-ladder-*.json text eol=lf
# AchievementLadder writes RareItemFindings.json with LF as well.
spa/src/RareItemFindings.json text eol=lf
# RatedBgRosterExporter writes LF as well.
spa/src/rated-bg-roster.json text eol=lf
